# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database ---
# Local: mongodb://127.0.0.1:27017/ai-test-generator
# Atlas: mongodb+srv://<user>:<password>@<cluster>/ai-test-generator?retryWrites=true&w=majority
MONGODB_URI=

# --- Auth ---
# Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- AI provider (gemini | openai | anthropic) ---
AI_PROVIDER=gemini
AI_API_KEY=
# Optional: override the default model for the chosen provider
AI_MODEL=
# Optional: override the API base URL (self-hosted or proxy)
AI_BASE_URL=
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=90000

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# --- OCR ---
OCR_LANGUAGES=eng
